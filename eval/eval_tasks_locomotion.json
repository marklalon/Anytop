    { "category": "Basic", "args": ["--object_type", "Spider", "--action_label", "run, forward"] },
    { "category": "Basic", "args": ["--object_type", "Spider", "--action_label", "fall"] },
    { "category": "Basic", "args": ["--object_type", "Parrot", "--action_label", "fly, forward"] },
    { "category": "Basic", "args": ["--object_type", "Parrot", "--action_label", "hover"] },
    { "category": "Basic", "args": ["--object_type", "KI_Human", "--action_label", "run, forward"] },
    { "category": "Basic", "args": ["--object_type", "KI_Human", "--action_label", "swim, forward"] },

    { "category": "ConvertLoop", "args": ["--reference_motion", "outputs/test/Buffalo_Run_Noloop.npy", "--skip_timesteps", "80", "--loop"], "eval_label": "run" },

