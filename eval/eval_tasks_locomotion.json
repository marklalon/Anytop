    { "category": "NewSkeleton", "args": ["--cond_path", "outputs/new_skeleton/cond.npy", "--reference_motion", "outputs/test/dragon_walk.glb", "--inpaint_joints", "RightThigh,LeftThigh,RightClavicle,LeftClavicle", "--skip_timesteps", "20"], "eval_label": "walk" }
